# ==========================================
# CommitGuard Environment Variables Example
# ==========================================
# Copy this file to '.env' and fill in the values below.

# --- Database ---
# URL for the Prisma SQLite database. 
# Default value sets the database locally at the project root.
DATABASE_URL="file:./dev.db"

# --- Machine Learning Engine ---
# The URL where the Python FastAPI microservice is running.
# Default: http://localhost:8000 when using docker-compose.
ML_ENGINE_URL="http://localhost:8000"

# --- GitHub Integration ---
# Your Personal Access Token (Classic or Fine-grained) for fetching PR data.
GITHUB_TOKEN="ghp_your_github_personal_access_token_here"

# The target repository you want to monitor PRs for.
NEXT_PUBLIC_GITHUB_OWNER="your-github-username-or-org"
NEXT_PUBLIC_GITHUB_REPO="your-repo-name"

# The secret phrase configured in your GitHub Webhook settings 
# used to verify incoming payloads cryptographically.
GITHUB_WEBHOOK_SECRET="your_secure_webhook_secret"

# --- Groq LLM (PR Summarizer) ---
# API Key from Groq for the Llama-3 AI summarizer feature.
# Get one at: https://console.groq.com/keys
GROQ_API_KEY="gsk_your_groq_api_key_here"
