// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model WebhookEvent {
  id          String   @id @default(cuid())
  event       String   // push, pull_request, etc
  action      String   // opened, closed, synchronize, ignored
  prNumber    Int?
  title       String?
  sender      String
  repo        String
  receivedAt  DateTime @default(now())
}

model DocSticker {
  id           String   @id @default(cuid())
  prNumber     Int
  funcName     String
  docPath      String
  content      String   // The sticker message
  createdAt    DateTime @default(now())
}

model AIDetection {
  id                String   @id @default(cuid())
  prNumber          Int      @unique
  score             Int      // 0-100
  confidence        String   // Low/Medium/High
  reasoning         String   // JSON string of reasoning points
  isBot             Boolean
  recommendedAction String
  createdAt         DateTime @default(now())
}

model ExpertHistory {
  id          String   @id @default(cuid())
  login       String
  domain      String   // e.g. .css, .ts, database
  commits     Int
  updatedAt   DateTime @updatedAt

  @@unique([login, domain])
}
